{
  "name": "Studio",
  "type": "object",
  "properties": {
    "niche": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "voice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark"
      ],
      "enumColors": [
        "blue",
        "pink",
        "yellow",
        "purple",
        "green"
      ],
      "default": "river"
    },
    "videos_per_day": {
      "type": "number",
      "default": 5
    },
    "duration_target": {
      "type": "number",
      "default": 30
    },
    "visual_style": {
      "type": "string"
    },
    "base_hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cta": {
      "type": "string"
    },
    "avoid": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}